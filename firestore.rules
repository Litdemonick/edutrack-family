rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios autenticados pueden acceder
    function isAuth() {
      return request.auth != null;
    }

    // ── Tareas ───────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read, write: if isAuth();
    }

    // ── Imágenes (base64 via Firestore) ──────────────────────
    // Colección usada por ImageTransferService para transferir
    // fotos de referencia (Admin→Student) y evidencias (Student→Admin)
    match /task_images/{imageId} {
      allow read, write: if isAuth();
    }

    // ── Eventos ──────────────────────────────────────────────
    match /events/{eventId} {
      allow read, write: if isAuth();
    }

    // ── Bloquear todo lo demás ────────────────────────────────
    // Dispositivos registrados para FCM (token + rol admin/student)
    match /devices/{deviceId} {
      allow read, write: if isAuth();
    }

    // Cola de push que procesa Cloud Functions para entregar por rol
    match /push_queue/{pushId} {
      allow create, read, update: if isAuth();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
